{
  "name": "KJV Bible Reader",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "user": "ubuntu",
  "install": "mvn -q -DskipTests clean package",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "app",
      "command": "mvn spring-boot:run"
    }
  ],
  "ports": [8081]
}
